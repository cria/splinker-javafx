<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.CheckComboBox?>
<VBox fx:id="pane" spacing="20" prefWidth="580" styleClass="modern-view,dialog-page" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.org.cria.splinkerapp.controllers.InstallConfirmationController">
    <ImageView fitWidth="150" fitHeight="40" preserveRatio="true" smooth="true" accessibleText="spLinker">
    <image><Image url="@../../../../images/splinker.png"/></image>
    <viewport><Rectangle2D minX="580" minY="1940" width="4320" height="850"/></viewport>
</ImageView>
    <Label fx:id="lblMessage" text="%update.downloaded" wrapText="true" styleClass="body-copy"/>
    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Button fx:id="btnNo" text="%button.later" onAction="#onBtnNoClicked"/>
        <Button fx:id="btnYes" text="%button.install" onAction="#onBtnYesClicked" styleClass="primary-button"/>
    </HBox>
</VBox>
