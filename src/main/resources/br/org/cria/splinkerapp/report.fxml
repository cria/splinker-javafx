<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.CheckComboBox?>
<VBox fx:id="pane" spacing="20" prefWidth="650" styleClass="modern-view,page-view" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.org.cria.splinkerapp.controllers.ReportController">
    <Label fx:id="proxyLabel" text="%history" styleClass="page-heading"/>
    <TableView fx:id="tableView" prefHeight="380" VBox.vgrow="ALWAYS">
        <placeholder><Label text="%table.empty" styleClass="muted-label"/></placeholder>
        <columns><TableColumn fx:id="colData" prefWidth="260" text="%date"/><TableColumn fx:id="colRegistros" prefWidth="340" text="%records.sent"/></columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
</VBox>
