<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.CheckComboBox?>
<VBox fx:id="pane" spacing="20" prefWidth="820" styleClass="modern-view,dialog-page" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.org.cria.splinkerapp.controllers.BatchFileTransferProgressController">
    <Label text="%transfer.progress" styleClass="page-heading"/>
    <HBox spacing="24">
        <VBox spacing="16" prefWidth="330" HBox.hgrow="ALWAYS" styleClass="form-card">
            <Label text="%transfer.processing" styleClass="field-label"/>
            <Label fx:id="lblColecaoAtual" text="—" wrapText="true" styleClass="section-heading"/>
            <Label text="%transfer.stage" styleClass="field-label"/>
            <Label fx:id="lblMessage" text="" wrapText="true" minHeight="80"/>
            <ProgressIndicator fx:id="progressIndicator" prefWidth="48" prefHeight="48" maxWidth="48" progress="0"/>
            <ProgressBar fx:id="progressBar" maxWidth="Infinity" progress="0"/>
        </VBox>
        <VBox spacing="14" prefWidth="340" HBox.hgrow="ALWAYS">
            <Label text="%transfer.partial" styleClass="section-heading"/>
            <TableView fx:id="tblResultadosParciais" prefHeight="300" VBox.vgrow="ALWAYS">
                <placeholder><Label text="%table.empty" styleClass="muted-label"/></placeholder>
                <columns><TableColumn fx:id="colStatusIcon" prefWidth="40" text=""/><TableColumn fx:id="colToken" prefWidth="290" text="%collections"/></columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
        </VBox>
    </HBox>
    <HBox spacing="24" styleClass="summary-strip">
        <VBox spacing="6"><Label text="%total.label"/><Label fx:id="lblTotal" text="0" styleClass="summary-value"/></VBox>
        <VBox spacing="6"><Label text="%success.label"/><Label fx:id="lblSucesso" text="0" styleClass="summary-value"/></VBox>
        <VBox spacing="6"><Label text="%error.label"/><Label fx:id="lblErro" text="0" styleClass="summary-value"/></VBox>
        <VBox spacing="6"><Label text="%remaining.label"/><Label fx:id="lblFaltam" text="0" styleClass="summary-value"/></VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnCancelar" text="%button.cancel" styleClass="danger-button"/>
    </HBox>
</VBox>
