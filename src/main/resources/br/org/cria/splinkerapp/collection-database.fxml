<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.CheckComboBox?>
<VBox fx:id="pane" spacing="20" prefWidth="650" styleClass="modern-view,form-page" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.org.cria.splinkerapp.controllers.CollectionLocalDatabaseController">
    <Label text="%database.name" styleClass="section-heading"/>
    <VBox spacing="8"><Label text="%host" styleClass="field-label" labelFor="$hostAddressField"/><TextField fx:id="hostAddressField" promptText="%host"/></VBox>
    <HBox spacing="16">
        <VBox spacing="8" HBox.hgrow="ALWAYS"><Label text="%database.prompt" styleClass="field-label" labelFor="$dbNameField"/><TextField fx:id="dbNameField" promptText="%database.name"/></VBox>
        <VBox spacing="8" prefWidth="120"><Label text="%port" styleClass="field-label" labelFor="$portField"/><TextField fx:id="portField" promptText="%port"/></VBox>
    </HBox>
    <VBox spacing="8"><Label text="%username" styleClass="field-label" labelFor="$usernameField"/><TextField fx:id="usernameField" promptText="%username"/></VBox>
    <VBox spacing="8"><Label text="%password" styleClass="field-label" labelFor="$passwordField"/><PasswordField fx:id="passwordField" promptText="%password"/></VBox>
    <HBox alignment="CENTER_RIGHT"><Button fx:id="btnSalvar" text="%button.save" onAction="#onSaveButtonClicked" styleClass="primary-button"/></HBox>
</VBox>
