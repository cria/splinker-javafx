<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.CheckComboBox?>
<VBox fx:id="pane" spacing="20" prefWidth="650" styleClass="modern-view,page-view" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.org.cria.splinkerapp.controllers.ConfigurationController">
    <Label text="%settings" styleClass="page-heading"/>
    <HBox spacing="8" styleClass="settings-tabs">
        <Label fx:id="serverLabel" id="serverLabel" text="%server" onMouseClicked="#showCentralServiceConfiguration" styleClass="settings-tab"/>
        <Label fx:id="proxyLabel" id="proxyLabel" text="%proxy" onMouseClicked="#showProxyConfiguration" styleClass="settings-tab"/>
        <Label fx:id="tokenLabel" id="tokenLabel" text="%token" onMouseClicked="#showTokenConfiguration" styleClass="settings-tab"/>
        <Label fx:id="dataLabel" id="dataLabel" text="%data" onMouseClicked="#showDataSourceConfiguration" styleClass="settings-tab"/>
    </HBox>
    <StackPane fx:id="content" alignment="TOP_LEFT"/>
</VBox>
