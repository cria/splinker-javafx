<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.CheckComboBox?>
<VBox fx:id="pane" spacing="20" prefWidth="650" styleClass="modern-view,dialog-page" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.org.cria.splinkerapp.controllers.BatchSelectFileTransferController">
    <ImageView fitWidth="150" fitHeight="40" preserveRatio="true" smooth="true" accessibleText="spLinker">
    <image><Image url="@../../../../images/splinker.png"/></image>
    <viewport><Rectangle2D minX="580" minY="1940" width="4320" height="850"/></viewport>
</ImageView>
    <Label fx:id="proxyLabel" text="%dashboard.send" styleClass="page-heading"/>
    <VBox spacing="12" styleClass="form-card">
        <Label text="%collections" styleClass="field-label" labelFor="$cmbToken"/>
        <CheckComboBox fx:id="cmbToken" maxWidth="Infinity"/>
        <HBox alignment="CENTER_RIGHT" spacing="12">
            <Button fx:id="btnCancelar" text="%button.cancel"/>
            <Button fx:id="btnEnviar" text="%button.send" styleClass="primary-button"/>
        </HBox>
    </VBox>
</VBox>
