<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.CheckComboBox?>
<VBox fx:id="pane" spacing="20" prefWidth="650" styleClass="modern-view,form-page" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.org.cria.splinkerapp.controllers.FileSelectionController">
    <Label fx:id="sourceTypeTitle" text="%file.path" wrapText="true" styleClass="section-heading"/>
    <Label fx:id="sourceTypeDescription" text="%file.description" wrapText="true" styleClass="muted-label"/>
    <HBox fx:id="localBox" spacing="10">
        <TextField fx:id="localFilePath" editable="false" HBox.hgrow="ALWAYS" accessibleText="%file.path"/>
        <Button fx:id="btnSelectFile" onAction="#onButtonSelectFileClicked" minWidth="44" accessibleText="%file.path"/>
    </HBox>
    <HBox fx:id="remoteBox" managed="false" visible="false"><TextField fx:id="remoteUrl" promptText="%file.link.prompt" HBox.hgrow="ALWAYS"/></HBox>
    <Label fx:id="remoteHelpLabel" text="%file.link.help" managed="false" visible="false" wrapText="true" styleClass="info-note"/>
    <HBox alignment="CENTER_RIGHT"><Button fx:id="btnSave" text="%button.save" onAction="#onButtonSaveClicked" styleClass="primary-button"/></HBox>
</VBox>
