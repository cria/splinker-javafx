<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.CheckComboBox?>
<VBox fx:id="pane" spacing="20" prefWidth="820" styleClass="modern-view,dialog-page" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.org.cria.splinkerapp.controllers.BatchFileTransferResultController">
    <Label text="%transfer.result" styleClass="page-heading"/>
    <TableView fx:id="tblResultados" prefHeight="360" VBox.vgrow="ALWAYS">
        <placeholder><Label text="%table.empty" styleClass="muted-label"/></placeholder>
        <columns>
            <TableColumn fx:id="colStatusIcon" prefWidth="40" text=""/>
            <TableColumn fx:id="colToken" prefWidth="105" text="%collection"/>
            <TableColumn fx:id="colStatus" prefWidth="110" text="%status"/>
            <TableColumn fx:id="colMensagem" prefWidth="360" text="%message"/>
            <TableColumn fx:id="colAcao" prefWidth="120" text=""/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
    <HBox alignment="CENTER_RIGHT"><Button fx:id="btnFechar" text="%button.close" styleClass="primary-button"/></HBox>
</VBox>
