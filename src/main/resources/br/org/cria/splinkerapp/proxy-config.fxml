<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.CheckComboBox?>
<VBox fx:id="pane" spacing="20" prefWidth="650" styleClass="modern-view,form-page" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.org.cria.splinkerapp.controllers.ProxyConfigController">
    <Label text="%proxy.config" styleClass="section-heading"/>
    <HBox spacing="16">
        <VBox spacing="8" HBox.hgrow="ALWAYS"><Label text="%address" styleClass="field-label" labelFor="$proxyAddress"/><TextField fx:id="proxyAddress" promptText="%address"/></VBox>
        <VBox spacing="8" prefWidth="120"><Label text="%port" styleClass="field-label" labelFor="$proxyPort"/><TextField fx:id="proxyPort" promptText="%port"/></VBox>
    </HBox>
    <VBox spacing="8"><Label text="%username" styleClass="field-label" labelFor="$proxyUsername"/><TextField fx:id="proxyUsername" promptText="%username"/></VBox>
    <VBox spacing="8"><Label text="%password" styleClass="field-label" labelFor="$proxyPassword"/><PasswordField fx:id="proxyPassword" promptText="%password"/></VBox>
    <HBox alignment="CENTER_RIGHT"><Button fx:id="saveBtn" text="%button.save" onAction="#onButtonSaveClicked" styleClass="primary-button"/></HBox>
</VBox>
