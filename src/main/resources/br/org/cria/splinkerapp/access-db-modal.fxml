<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.CheckComboBox?>
<VBox fx:id="pane" spacing="20" prefWidth="650" styleClass="modern-view,form-page" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.org.cria.splinkerapp.controllers.AccessDbController">
    <Label text="%data" styleClass="section-heading"/>
    <VBox spacing="8">
        <Label text="%file.path" styleClass="field-label" labelFor="$accessFilePathField"/>
        <HBox spacing="10">
            <TextField fx:id="accessFilePathField" promptText="%file.path" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnSelectFile" onAction="#onBtnSelectFileClick" minWidth="44" accessibleText="%file.path"/>
        </HBox>
    </VBox>
    <VBox spacing="8"><Label text="%password" styleClass="field-label" labelFor="$accessPasswordField"/><PasswordField fx:id="accessPasswordField" promptText="%password.optional"/></VBox>
    <HBox alignment="CENTER_RIGHT"><Button fx:id="btnSave" text="%button.save" onAction="#onBtnSaveClicked" styleClass="primary-button"/></HBox>
</VBox>
