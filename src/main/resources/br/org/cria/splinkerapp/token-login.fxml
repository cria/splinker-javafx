<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.CheckComboBox?>
<VBox fx:id="pane" spacing="20" prefWidth="650" styleClass="modern-view,form-page" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.org.cria.splinkerapp.controllers.TokenLoginController">
    <Label text="%token" styleClass="section-heading"/>
    <Label text="%token.description" wrapText="true" styleClass="muted-label"/>
    <TextField fx:id="tokenField" promptText="%token.prompt" accessibleText="%token"/>
    <VBox fx:id="tokenBox" spacing="10"/>
    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Button fx:id="btnDeleteToken" text="%button.delete" onAction="#onButtonDeleteTokenClicked" styleClass="danger-button" managed="${btnDeleteToken.visible}"/>
        <Button fx:id="btnAddToken" text="%button.save" onAction="#onButtonAddTokenClicked" styleClass="primary-button"/>
    </HBox>
</VBox>
