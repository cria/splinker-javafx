<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="pane" spacing="22" prefWidth="650" styleClass="dashboard" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.org.cria.splinkerapp.controllers.PrincipalController">
    <VBox spacing="6">
        <Label text="%dashboard.title" styleClass="page-heading"/>
        <Label text="%dashboard.subtitle" wrapText="true" styleClass="muted-label"/>
    </VBox>
    <VBox spacing="16" styleClass="collection-card">
        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
        <HBox alignment="CENTER_LEFT" spacing="16">
            <Label text="%dashboard.collection" styleClass="eyebrow"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="cmbCollection" onAction="#onCmbCollectionChange" prefWidth="180" maxWidth="220" accessibleText="%dashboard.collection"/>
        </HBox>
        <Label fx:id="lblCollectionName" text="%collection.name" wrapText="true" minHeight="64" maxWidth="Infinity" styleClass="collection-title"/>
        <Separator/>
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="%dashboard.send.hint" wrapText="true" maxWidth="350" styleClass="muted-label" HBox.hgrow="ALWAYS"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="syncServerBtn" text="%dashboard.send" onAction="#onSyncServerBtnClicked" minWidth="152" styleClass="send-button"/>
        </HBox>
    </VBox>
    <HBox spacing="18">
        <VBox spacing="14" styleClass="stat-card" HBox.hgrow="ALWAYS" prefWidth="310">
            <padding><Insets top="22" right="22" bottom="22" left="22"/></padding>
            <Label text="%transfer.last" styleClass="muted-label"/>
            <Label fx:id="lblLastUpdate" text="—" wrapText="true" styleClass="date-value"/>
        </VBox>
        <VBox spacing="10" styleClass="stat-card" HBox.hgrow="ALWAYS" prefWidth="310">
            <padding><Insets top="22" right="22" bottom="22" left="22"/></padding>
            <Label text="%records.sent" styleClass="muted-label"/>
            <Label fx:id="lblRecordsSent" text="—" wrapText="true" styleClass="stat-value"/>
        </VBox>
    </HBox>
</VBox>
