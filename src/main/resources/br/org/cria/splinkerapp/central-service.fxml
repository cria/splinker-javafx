<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.CheckComboBox?>
<VBox fx:id="pane" spacing="20" prefWidth="650" styleClass="modern-view,form-page" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.org.cria.splinkerapp.controllers.CentralServiceController">
    <Label text="%server" styleClass="section-heading"/>
    <VBox spacing="8">
        <Label text="%central.url" styleClass="field-label" labelFor="$urlField"/>
        <TextField fx:id="urlField" promptText="%central.url"/>
    </VBox>
    <HBox alignment="CENTER_RIGHT"><Button fx:id="btnSave" text="%button.save" onAction="#onButtonSavedClick" styleClass="primary-button"/></HBox>
</VBox>
