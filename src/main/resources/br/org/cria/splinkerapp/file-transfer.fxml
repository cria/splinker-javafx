<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.CheckComboBox?>
<VBox fx:id="pane" spacing="20" prefWidth="600" styleClass="modern-view,dialog-page" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.org.cria.splinkerapp.controllers.FileTransferController">
    <ImageView fitWidth="150" fitHeight="40" preserveRatio="true" smooth="true" accessibleText="spLinker">
    <image><Image url="@../../../../images/splinker.png"/></image>
    <viewport><Rectangle2D minX="580" minY="1940" width="4320" height="850"/></viewport>
</ImageView>
    <Label fx:id="lblMessage" text="%transfer.confirm" wrapText="true" styleClass="body-copy"/>
    <ProgressIndicator fx:id="progressIndicator" prefWidth="48" prefHeight="48" maxWidth="48" progress="0" managed="${progressIndicator.visible}"/>
    <ProgressBar fx:id="progressBar" maxWidth="Infinity" progress="0" managed="${progressBar.visible}"/>
    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Button fx:id="btnNo" text="%button.cancel" onAction="#onBtnNoClicked" managed="${btnNo.visible}"/>
        <Button fx:id="btnYes" text="%button.start" onAction="#onBtnYesClicked" styleClass="primary-button" managed="${btnYes.visible}"/>
        <Button fx:id="btnCancelTransfer" text="%button.cancel" onAction="#onButtonCancelClicked" styleClass="danger-button" managed="${btnCancelTransfer.visible}"/>
    </HBox>
</VBox>
