<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.CheckComboBox?>
<VBox fx:id="pane" spacing="20" prefWidth="650" styleClass="modern-view,page-view" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.org.cria.splinkerapp.controllers.EmailController">
    <Label fx:id="proxyLabel" text="%email.contact" styleClass="page-heading"/>
    <VBox spacing="18" styleClass="form-card">
        <HBox spacing="16">
            <VBox spacing="8" HBox.hgrow="ALWAYS"><Label text="%title" styleClass="field-label" labelFor="$cmbAssunto"/><ComboBox fx:id="cmbAssunto" maxWidth="Infinity"/></VBox>
            <VBox spacing="8" HBox.hgrow="ALWAYS"><Label text="%token" styleClass="field-label" labelFor="$cmbToken"/><ComboBox fx:id="cmbToken" maxWidth="Infinity"/></VBox>
        </HBox>
        <VBox spacing="8"><Label text="%message" styleClass="field-label" labelFor="$urlField"/><TextArea fx:id="urlField" promptText="%message" wrapText="true" prefRowCount="6"/></VBox>
        <VBox spacing="8"><Label text="%email.collection" styleClass="field-label" labelFor="$emailField"/><TextField fx:id="emailField" promptText="%email"/></VBox>
        <HBox alignment="CENTER_RIGHT"><Button fx:id="btnSave" text="%button.send" styleClass="primary-button"/></HBox>
    </VBox>
</VBox>
