<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.CheckComboBox?>
<VBox fx:id="pane" spacing="20" prefWidth="520" styleClass="modern-view,dialog-page" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.org.cria.splinkerapp.controllers.DeleteDataSourceController">
    <Label text="%button.delete" styleClass="page-heading"/>
    <Label fx:id="lblMsg" text="%dataset.delete" wrapText="true" styleClass="body-copy"/>
    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Button fx:id="btnNo" text="%button.no" onAction="#onButtonNoClicked"/>
        <Button fx:id="btnYes" text="%button.yes" onAction="#onButtonYesClicked" styleClass="danger-button"/>
    </HBox>
</VBox>
