<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.CheckComboBox?>
<VBox fx:id="pane" spacing="20" prefWidth="560" styleClass="modern-view,dialog-page" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.org.cria.splinkerapp.controllers.SpLinkerUpdateController">
    <ImageView fitWidth="150" fitHeight="40" preserveRatio="true" smooth="true" accessibleText="spLinker">
    <image><Image url="@../../../../images/splinker.png"/></image>
    <viewport><Rectangle2D minX="580" minY="1940" width="4320" height="850"/></viewport>
</ImageView>
    <Label fx:id="lblMessage" text="%update.available" wrapText="true" styleClass="body-copy"/>
    <ProgressIndicator fx:id="progressIndicator" prefWidth="44" prefHeight="44" maxWidth="44" progress="0" visible="false" managed="${progressIndicator.visible}"/>
    <ProgressBar fx:id="progressBar" maxWidth="Infinity" progress="0" visible="false" managed="${progressBar.visible}"/>
    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Button fx:id="btnNo" text="%button.no" onAction="#onBtnNoClicked" managed="${btnNo.visible}"/>
        <Button fx:id="btnYes" text="%button.yes" onAction="#onBtnYesClicked" styleClass="primary-button" managed="${btnYes.visible}"/>
    </HBox>
</VBox>
